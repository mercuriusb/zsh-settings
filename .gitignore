# Machine-local zsh config. The README promises these are untracked, so
# this is what actually makes that true. template.zsh.file is kept: only
# *.zsh gets sourced, which is exactly why the example has another suffix.
.zsh/local/*.zsh

# Generated by .zshrc at shell startup -- never belongs in the repo.
.zsh_cache/
.zcompdump
.zcompdump.zwc
.zcompdump-*

# Personal, and potentially full of secrets typed on a command line.
.zsh_history

# envman writes this itself ("Generated for envman. Do not edit."),
# and .zshrc only sources it if present.
.config/envman/

# Editor and OS leftovers
*~
*.swp
*.swo
.DS_Store
.idea/
.vscode/

# NOTE: config.tgz is deliberately NOT ignored. It is the shippable
# archive and is meant to be committed -- rebuild it with ./pack-config.sh.
